# PostgreSQL
DB_PASSWORD=changeme

# Sauvegarde DB → Google Drive (voir infra/backup/README.md)
GDRIVE_REMOTE=gdrive:project-gestion-backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
RCLONE_CONFIG_B64=

# Django
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Origines autorisees a envoyer des requetes non-safe (POST/PUT/PATCH/DELETE)
# avec cookie de session (web). Defaut = FRONTEND_APP_URL si absent.
CSRF_TRUSTED_ORIGINS=http://localhost:3000
# A remplir uniquement si front et back vivent sur des sous-domaines distincts
# d'un meme domaine (ex. .example.com) : sans Domain explicite, le cookie est
# host-only et n'est jamais renvoye au sous-domaine du front.
# Laisser vide en local (meme host, ports differents).
SESSION_COOKIE_DOMAIN=
CSRF_COOKIE_DOMAIN=

INVITATION_EXPIRES_DAYS=7
# Base du frontend. Les chemins des pages d'auth (login, register,
# reset-password, verify-email...) sont definis dans config/settings.py
# (HEADLESS_FRONTEND_URLS) et derivent tous de cette base.
FRONTEND_APP_URL=http://localhost:3000

# OAuth Google (allauth Headless, flux redirect). Voir Google Cloud Console >
# Identifiants > ID client OAuth. Redirect URI a autoriser :
# http://localhost:8000/accounts/google/login/callback/ (dev) et l'equivalent
# https://<domaine-backend>/accounts/google/login/callback/ en prod.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Email / Resend
DEFAULT_FROM_EMAIL=Project Gestion <no-reply@your-domain.com>
SERVER_EMAIL=Project Gestion <no-reply@your-domain.com>
DEFAULT_REPLY_TO_EMAIL=
RESEND_API_KEY=
RESEND_SIGNING_SECRET=
RESEND_INVITATION_TEMPLATE_ID=
RESEND_PASSWORD_RESET_TEMPLATE_ID=
RESEND_EMAIL_VERIFICATION_TEMPLATE_ID=
# Optional. Leave empty to auto-use Resend when RESEND_API_KEY is set,
# otherwise console email in local dev.
EMAIL_BACKEND=

# API rate limiting
# Login/inscription sont limites nativement par allauth (ACCOUNT_RATE_LIMITS),
# pas ici : ces reglages ne couvrent que les endpoints DRF custom restants.
THROTTLE_PASSWORD_RESET_RATE=3/hour

# MinIO / S3
# Required only when upload/download features are used.
S3_ACCESS_KEY_ID=mtx_26
S3_SECRET_ACCESS_KEY=ton_mot_de_passe_minio
S3_ENDPOINT_URL=http://localhost:32768
S3_BUCKET_NAME=project-documents
PROFILE_PICTURE_S3_BUCKET_NAME=
S3_REGION=us-east-1
S3_PRESIGNED_URL_EXPIRES_SECONDS=300

# Upload limits and allowed types are optional.
# Uncomment only if you need to override the backend defaults.
# DOCUMENT_MAX_UPLOAD_SIZE_BYTES=104857600
# DOCUMENT_ALLOWED_FILE_EXTENSIONS=.pdf,.jpg,.jpeg,.png,.webp,.gif,.tif,.tiff,.bmp,.svg,.heic,.heif,.dwg,.dxf,.ifc,.rvt,.skp,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.csv
# DOCUMENT_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp,image/gif,image/tiff,image/bmp,image/svg+xml,image/heic,image/heif,application/acad,application/x-acad,application/autocad_dwg,image/vnd.dwg,application/dwg,application/dxf,image/vnd.dxf,application/ifc,application/x-step,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/msword,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/vnd.ms-powerpoint,text/plain,text/csv
# DOCUMENT_FALLBACK_MIME_TYPES=application/octet-stream
# PROFILE_PICTURE_MAX_UPLOAD_SIZE_BYTES=5242880
# PROFILE_PICTURE_ALLOWED_FILE_EXTENSIONS=.jpg,.jpeg,.png,.webp,.gif
# PROFILE_PICTURE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif


# Public frontend/mobile
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Web : utiliser localhost (et non une IP) pour que le cookie de session soit
# considere same-site avec le frontend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Mobile : IP du LAN (un appareil physique ne peut pas joindre localhost).
# Ecrase automatiquement par apps/mobile/scripts/start.js.
EXPO_PUBLIC_API_BASE_URL=http://192.168.0.196:8000

# Google Sign-In mobile (@react-native-google-signin/google-signin).
# Requiert un build de dev — inoperant dans Expo Go.
# Google Cloud Console > Identifiants :
#  - Client Web : le MEME que GOOGLE_OAUTH_CLIENT_ID ci-dessus. C'est
#    l'audience de l'id_token verifie par le backend.
#  - Client iOS : necessaire pour le flux natif iOS. Le schema d'URL iOS
#    ("reversed client ID") en est derive automatiquement par app.config.js.
#  - Client Android : a creer aussi (empreinte SHA-1 requise) ; aucun
#    identifiant a mettre ici, Google l'associe au package name.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
