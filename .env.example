# PostgreSQL
DB_PASSWORD=changeme

# Sauvegarde DB → Google Drive (voir infra/backup/README.md)
GDRIVE_REMOTE=gdrive:project-gestion-backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
RCLONE_CONFIG_B64=

# Django
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Origines autorisees a envoyer un jeton CSRF. Sert aussi a valider le `callback_url`
# du flux OAuth headless. Par defaut : CORS_ALLOWED_ORIGINS.
CSRF_TRUSTED_ORIGINS=http://localhost:3000

INVITATION_EXPIRES_DAYS=7
FRONTEND_APP_URL=http://localhost:3000
PASSWORD_RESET_CONFIRM_URL=http://localhost:3000/auth/reset-password
EMAIL_VERIFICATION_URL=http://localhost:3000/auth/verify-email

# Sessions Django (cookies HttpOnly). Le web et l'API doivent partager le meme site
# pour que "Lax" suffise : en local, utiliser localhost des deux cotes (le port
# n'entre pas dans le calcul du site). En production cross-domaine strict, passer a
# SESSION_COOKIE_SAMESITE=None avec des cookies Secure.
# Par defaut : Secure = true des que DJANGO_DEBUG=false.
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
# CSRF_COOKIE_SAMESITE=Lax
# Domaine partage entre le frontend et l'API, ex. .exemple.com
# SESSION_COOKIE_DOMAIN=
# CSRF_COOKIE_DOMAIN=
# Duree de vie de la session, en secondes (14 jours par defaut).
# SESSION_COOKIE_AGE=1209600

# Google OAuth (django-allauth). Voir la console Google Cloud :
# URI de redirection autorisee = <BACKEND>/accounts/google/login/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Email / Resend
DEFAULT_FROM_EMAIL=Project Gestion <no-reply@your-domain.com>
SERVER_EMAIL=Project Gestion <no-reply@your-domain.com>
DEFAULT_REPLY_TO_EMAIL=
RESEND_API_KEY=
RESEND_SIGNING_SECRET=
RESEND_INVITATION_TEMPLATE_ID=
RESEND_PASSWORD_RESET_TEMPLATE_ID=
RESEND_EMAIL_VERIFICATION_TEMPLATE_ID=
# Optional. Leave empty to auto-use Resend when RESEND_API_KEY is set,
# otherwise console email in local dev.
EMAIL_BACKEND=

# Limites de debit de django-allauth (format "<nombre>/<periode>/<portee>")
THROTTLE_LOGIN_RATE=30/m/ip
THROTTLE_LOGIN_FAILED_RATE=10/m/ip,5/300s/key
THROTTLE_SIGNUP_RATE=20/m/ip
THROTTLE_PASSWORD_RESET_RATE=20/m/ip,5/m/key
THROTTLE_PASSWORD_RESET_CONFIRM_RATE=20/m/ip
THROTTLE_PASSWORD_CHANGE_RATE=5/m/user
THROTTLE_EMAIL_RESEND_RATE=1/180s/key
# Limite DRF de l'upload de photo de profil
THROTTLE_PROFILE_PICTURE_RATE=10/hour

# MinIO / S3
# Required only when upload/download features are used.
S3_ACCESS_KEY_ID=mtx_26
S3_SECRET_ACCESS_KEY=ton_mot_de_passe_minio
S3_ENDPOINT_URL=http://localhost:32768
S3_BUCKET_NAME=project-documents
PROFILE_PICTURE_S3_BUCKET_NAME=
S3_REGION=us-east-1
S3_PRESIGNED_URL_EXPIRES_SECONDS=300

# Upload limits and allowed types are optional.
# Uncomment only if you need to override the backend defaults.
# DOCUMENT_MAX_UPLOAD_SIZE_BYTES=104857600
# DOCUMENT_ALLOWED_FILE_EXTENSIONS=.pdf,.jpg,.jpeg,.png,.webp,.gif,.tif,.tiff,.bmp,.svg,.heic,.heif,.dwg,.dxf,.ifc,.rvt,.skp,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.csv
# DOCUMENT_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp,image/gif,image/tiff,image/bmp,image/svg+xml,image/heic,image/heif,application/acad,application/x-acad,application/autocad_dwg,image/vnd.dwg,application/dwg,application/dxf,image/vnd.dxf,application/ifc,application/x-step,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/msword,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/vnd.ms-powerpoint,text/plain,text/csv
# DOCUMENT_FALLBACK_MIME_TYPES=application/octet-stream
# PROFILE_PICTURE_MAX_UPLOAD_SIZE_BYTES=5242880
# PROFILE_PICTURE_ALLOWED_FILE_EXTENSIONS=.jpg,.jpeg,.png,.webp,.gif
# PROFILE_PICTURE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif


# Public frontend/mobile
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Doit rester sur le meme site que NEXT_PUBLIC_APP_URL pour que le cookie de
# session soit envoye : localhost des deux cotes, pas 127.0.0.1 d'un cote.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
